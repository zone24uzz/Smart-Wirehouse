# Frontend value (copy to client/.env)
VITE_API_URL=http://localhost:5000/api

# Backend values (copy server/.env.example to server/.env)
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
JWT_SECRET=
JWT_EXPIRES_IN=24h
DATABASE_PATH=./data/db.json
# Leave empty for mock mode; supported values: gemini, openai.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEB_APP_URL=
